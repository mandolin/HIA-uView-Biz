{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/mandolin/HIA-uView-Biz/blob/main/docs/contracts/schemas/application-template.manifest.v1.schema.json",
  "title": "Application-template manifest / 应用模板 manifest",
  "description": "Declares bounded application integration slots and host projection policy without loading code or owning business facts. / 声明受限应用集成 slot 与宿主投影 policy，不加载代码或拥有业务事实。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "kind",
    "id",
    "adoptionProfileId",
    "primaryModuleId",
    "capabilitySlots",
    "hostPolicy",
    "routeProjection",
    "screenCapabilityPolicy"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1.0",
      "description": "Application-template contract version. / Application-template 契约版本。"
    },
    "kind": {
      "const": "application-template",
      "description": "Separates this artifact from business, implementation, adoption, and package manifests. / 将本产物与业务、实现、采用及 package manifest 区分。"
    },
    "id": {
      "$ref": "#/$defs/dottedIdentifier"
    },
    "adoptionProfileId": {
      "$ref": "#/$defs/dottedIdentifier"
    },
    "primaryModuleId": {
      "$ref": "#/$defs/dottedIdentifier"
    },
    "capabilitySlots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capabilitySlot"
      }
    },
    "hostPolicy": {
      "$ref": "#/$defs/hostPolicy"
    },
    "routeProjection": {
      "$ref": "#/$defs/routeProjection"
    },
    "screenCapabilityPolicy": {
      "$ref": "#/$defs/screenCapabilityPolicy"
    }
  },
  "$defs": {
    "dottedIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
      "description": "Stable lowercase dotted identifier. / 稳定的小写点分标识。"
    },
    "simpleIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable lowercase identifier. / 稳定的小写标识。"
    },
    "surfaceKind": {
      "enum": [
        "adapter",
        "channel-projection",
        "mock-command",
        "mock-session",
        "presentation-block"
      ],
      "description": "Implementation surface kind required by a slot. / slot 要求的 implementation surface kind。"
    },
    "capabilitySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "moduleId",
        "requiredState",
        "requiredSurfaces"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/simpleIdentifier"
        },
        "moduleId": {
          "$ref": "#/$defs/dottedIdentifier"
        },
        "requiredState": {
          "const": "enabled",
          "description": "The first contract requires every declared slot to be active. / 首版契约要求每个已声明 slot 都处于活动状态。"
        },
        "requiredSurfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/surfaceKind"
          }
        }
      }
    },
    "hostPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registeredBlocks",
        "registeredVisibility",
        "allowedPageSizes"
      ],
      "properties": {
        "registeredBlocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/simpleIdentifier"
          }
        },
        "registeredVisibility": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/simpleIdentifier"
          }
        },
        "allowedPageSizes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "screenId",
        "blocks"
      ],
      "properties": {
        "intent": {
          "$ref": "#/$defs/simpleIdentifier"
        },
        "screenId": {
          "$ref": "#/$defs/simpleIdentifier"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/simpleIdentifier"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/simpleIdentifier"
        },
        "from": {
          "$ref": "#/$defs/simpleIdentifier"
        },
        "to": {
          "$ref": "#/$defs/simpleIdentifier"
        }
      }
    },
    "routeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "screens",
        "actions"
      ],
      "properties": {
        "channel": {
          "enum": [
            "mp-weixin",
            "uni-app",
            "web",
            "native-app"
          ]
        },
        "screens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/screen"
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "screenCapabilityPolicy": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/simpleIdentifier"
          }
        }
      },
      "description": "Every registered screen receives an explicit bounded capability list. / 每个已登记 screen 获得显式受限 capability 列表。"
    }
  }
}
